{
  "manifest_version": 3,
  "name": "PhishLens",
  "version": "1.2.2",
  "description": "Explains noteworthy URL signals to help users make more careful decisions.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "icons/phishlens-16.png",
    "48": "icons/phishlens-48.png",
    "128": "icons/phishlens-128.png"
  },
  "action": {
    "default_title": "Check with PhishLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/phishlens-16.png",
      "32": "icons/phishlens-32.png"
    }
  },
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ]
}
